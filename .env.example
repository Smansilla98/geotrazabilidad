# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno — ejemplo para DESARROLLO LOCAL. Copiar a .env (no se versiona).
# En Railway se configuran por servicio (ver docs/RAILWAY_DEPLOYMENT.md).
# [OBLIGATORIA] = la API no arranca sin ella (en producción).
# ─────────────────────────────────────────────────────────────────────────────

# ── API (apps/api) ───────────────────────────────────────────────────────────
NODE_ENV=development
# Railway inyecta PORT; localmente 3000.
PORT=3000
HOST=0.0.0.0
# [OBLIGATORIA] PostgreSQL con PostGIS. docker-compose expone el puerto 5433.
DATABASE_URL=postgres://geo:geo_dev_password@localhost:5433/geo
# auto | require | disable  (auto: sin TLS para localhost y *.railway.internal)
DATABASE_SSL=auto
DB_POOL_MAX=10
# [OBLIGATORIA en producción] Mínimo 32 caracteres aleatorios: openssl rand -base64 48
# En desarrollo, si falta se genera uno efímero (las sesiones se pierden al reiniciar).
JWT_SECRET=
JWT_ACCESS_TTL_S=900
REFRESH_TTL_DAYS=30
DEVICE_REFRESH_TTL_DAYS=180
# [OBLIGATORIA en producción] Orígenes permitidos para CORS (coma). En dev se permite http://localhost:*.
CORS_ORIGINS=http://localhost:5173
# URL pública de la web: se usa en los enlaces de recuperación de contraseña.
WEB_URL=http://localhost:5173
# SMTP para recuperación de contraseña. Local: Mailpit (http://localhost:8025).
# Formato: smtp://usuario:clave@host:puerto  |  smtps://... para TLS implícito.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Geotrazabilidad <no-reply@localhost>
# Proveedor de rutas: osrm | none. El servidor demo de OSRM NO es apto para producción.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_USER_AGENT=geotrazabilidad-dev/0.1 (contacto: tu-email@ejemplo.com)
ROUTING_TIMEOUT_MS=10000
# Worker de reglas dentro del proceso de la API (true) o como servicio aparte (false + start:worker).
WORKER_ENABLED=true
WORKER_INTERVAL_MS=1000
RETENTION_ENABLED=true
DEMO_ENABLED=true
API_DOCS_ENABLED=true
LOG_LEVEL=info
# Saltos de proxy confiables (Railway: 1) para obtener la IP real del cliente.
TRUST_PROXY=1
RATE_LIMIT_PER_MIN=600
INGEST_RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_MIN=20
EXPORT_MAX_POINTS=200000

# ── Web (apps/web) ───────────────────────────────────────────────────────────
# El servidor web (server.mjs) hace de proxy hacia la API: el navegador nunca habla
# directo con la API ni ve secretos. Valores leídos en runtime (no se hornean en el bundle).
WEB_PORT=5173
# URL de la API vista desde el servidor web. En Railway: http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
API_INTERNAL_URL=http://localhost:3000
# Estilo de mapa (MapLibre). OpenFreeMap: sin clave. Requiere atribución (se muestra en el mapa).
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Cookies de sesión con Secure (true en producción detrás de HTTPS).
COOKIE_SECURE=false

# ── App móvil (apps/mobile) — se leen al compilar (EXPO_PUBLIC_* son públicas) ──
# En un teléfono físico usar la IP LAN de tu PC o la URL pública de Railway; nunca localhost.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_APP_ENV=development
