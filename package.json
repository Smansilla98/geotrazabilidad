{
  "name": "geoprueba",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build -w @geo/shared && npm run build -w @geo/api && npm run build -w @geo/web",
    "typecheck": "npm run build -w @geo/shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d db mailpit",
    "db:migrate": "npm run migrate -w @geo/api",
    "demo:seed": "npm run demo:seed -w @geo/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "railway": "^3.16.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
